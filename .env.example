# Copy this file to ".env" and fill in your own Supabase project credentials.
# Get these from: https://app.supabase.com -> your project -> Project Settings -> API
#
# If you leave this file as-is (or don't create .env at all), the app runs in
# "local mode": notes stay only in your browser and login is just a saved
# email with no real password — nothing breaks, you just don't get a real
# backend or real authentication.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Assistants (both free, no credit card required)
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys  (use a ":free" model, already set in code)
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
